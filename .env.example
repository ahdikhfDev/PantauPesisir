# PantauPesisir backend - copy to .env and fill in. Never commit real .env files.

# --- application ---
ENVIRONMENT=development
DEMO_MODE=true
LOG_LEVEL=INFO

# --- database ---
# Production (PostgreSQL + PostGIS):
# DATABASE_URL=postgresql+psycopg://cews:change-me@localhost:5432/cews
# Local demo default (SQLite, created automatically):
DATABASE_URL=sqlite:///data/cews.db

# --- security ---
# Required for ingestion, simulator control, satellite sync and alert updates.
# In DEMO_MODE the documented demo key below also works. Change in production.
API_SECRET_KEY=change-me-in-production
DEMO_API_KEY=pantaupesisir-demo-2026
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
INGESTION_RATE_LIMIT_PER_MINUTE=240

# --- authentication (prototype) ---
# Signing secret for dashboard bearer tokens. Rotate for any real deployment.
# Leave blank to disable the operator account. Never commit a real value.

# --- buoy simulator ---
SIMULATOR_DEFAULT_INTERVAL_SECONDS=60
SIMULATOR_AUTOSTART=false
SIMULATOR_ZONE_CODE=ALL

# --- satellite provider (Copernicus Data Space Ecosystem STAC) ---
SATELLITE_PROVIDER=copernicus-stac
SATELLITE_API_BASE_URL=https://stac.dataspace.copernicus.eu/v1
SATELLITE_COLLECTION=sentinel-2-l2a
SATELLITE_MAX_CLOUD_COVER_PERCENT=40
SATELLITE_CACHE_DIR=data/satellite
# Only needed if you later add authenticated product download (not used by default).
SATELLITE_CLIENT_ID=
SATELLITE_CLIENT_SECRET=

# --- analytics ---
ML_MODEL_VERSION=cews-iforest-v1
ML_MATCHING_WINDOW_MINUTES=30
ANALYTICS_WINDOW_MINUTES=60
ALERT_DEDUPE_MINUTES=30

# --- frontend (frontend/.env.local) ---
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# NEXT_PUBLIC_DEMO_USERNAME=demo
# NEXT_PUBLIC_DEMO_PASSWORD=demo-cews-2026
